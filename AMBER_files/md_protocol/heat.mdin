Stage 4 - Heat the system from 100 to 310 K under NVT with solute restraints
&cntrl
 ! Run control
 imin = 0,
 nstlim = 200000, dt = 0.001,

 ! Initial coordinates and restart behavior
 irest = 0, ntx = 1, ntxo = 2,

 ! Output control
 ntpr = 1000, ntwx = 1000, ntwr = 1000,
 ioutfm = 1, iwrap = 1,

 ! Temperature control
 tempi = 100.0, temp0 = 310.0,
 ntt = 3, gamma_ln = 5.0, ig = -1,
 nmropt = 1,

 ! Ensemble
 ntb = 1, ntp = 0,

 ! Integration and constraints
 ntc = 2, ntf = 2,
 cut = 10.0,
 nrespa = 1, nscm = 1000,

 ! Positional restraints
 ntr = 1,
 restraint_wt = 20.0,
 restraintmask = ":1-304",
&end
&wt
 TYPE = "TEMP0", ISTEP1 = 0, ISTEP2 = 100000,
 VALUE1 = 100.0, VALUE2 = 200.0,
&end
&wt
 TYPE = "TEMP0", ISTEP1 = 100001, ISTEP2 = 200000,
 VALUE1 = 200.0, VALUE2 = 310.0,
&end
&wt TYPE = 'END'
&end
